{
	"name": "cloudflare-vault-backup",
	"version": "1.3.0",
	"description": "Obsidian plugin that backs up a vault to your own Cloudflare R2 bucket with versioned snapshots, per-note restore and optional encryption",
	"author": {
		"name": "Bapusaheb Patil",
		"url": "https://bapspatil.com"
	},
	"homepage": "https://github.com/bapspatil/cloudflare-vault-backup#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bapspatil/cloudflare-vault-backup.git"
	},
	"bugs": {
		"url": "https://github.com/bapspatil/cloudflare-vault-backup/issues"
	},
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:int": "vitest run --project integration"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"backup",
		"cloudflare",
		"r2"
	],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/diff": "8.0.0",
		"@types/node": "^24.19.2",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-import-resolver-node": "0.4.0",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"happy-dom": "21.0.4",
		"jiti": "^2.6.1",
		"obsidian": "1.14.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"aws4fetch": "1.0.20",
		"diff": "9.0.0"
	},
	"overrides": {
		"moment": "2.31.0"
	}
}
